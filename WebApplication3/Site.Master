<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Site.Master.cs"
    Inherits="WebApplication3.SiteMaster" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Transpo<asp:ContentPlaceHolder ID="TitleContent" runat="server" /></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/CSS/style.css" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body class="transpo-master-body">
    <form id="form1" runat="server" class="tm-form-wrapper">

        <div class="tm-layout">

            <!-- PERMANENT SIDEBAR -->
            <aside id="tmSidebar" class="tm-sidebar">

                <a id="lnkBrand" runat="server" href="~/Dashboard.aspx" class="tm-brand" title="Transpo Home">
                    <span class="tm-brand-icon">🚚</span>
                    <span class="tm-brand-text">Transpo</span>
                </a>

                <nav class="tm-navigation" aria-label="Main navigation">
                    <asp:PlaceHolder ID="phSidebarLinks" runat="server" />
                </nav>

                <div class="tm-sidebar-bottom">
                    <asp:LinkButton ID="btnLogout" runat="server"
                        CssClass="tm-logout"
                        CausesValidation="false"
                        OnClick="btnLogout_Click">
                        <span class="tm-menu-icon">↪</span>
                        <span class="tm-menu-text">Logout</span>
                    </asp:LinkButton>
                </div>

            </aside>

            <!-- MAIN APPLICATION AREA -->
            <main class="tm-main">

                <!-- TOPBAR -->
                <header class="tm-topbar">

                    <div class="tm-page-heading">
                        <h1>
                            <asp:ContentPlaceHolder ID="PageTitle" runat="server">
                                Dashboard
                            </asp:ContentPlaceHolder>
                        </h1>
                    </div>

                    <div class="tm-user">
                        <div class="tm-avatar">
                            <asp:Literal ID="litAvatarLetter" runat="server" />
                        </div>

                        <div class="tm-user-info">
                            <strong>
                                <asp:Literal ID="litUserName" runat="server" />
                            </strong>
                            <span>
                                <asp:Literal ID="litUserRole" runat="server" />
                            </span>
                        </div>
                    </div>

                </header>

                <!-- MAIN CONTENT PLACEHOLDER -->
                <section class="tm-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </section>

            </main>

        </div>

    </form>
</body>
</html>
